# 1. On Telegram, open @BotFather, send /newbot and follow the steps
# 2. Copy this file to a new file called .env
# 3. Paste your bot token below (keep it secret — never commit .env!)
TELEGRAM_BOT_TOKEN=123456789:paste-your-token-here

# Optional: run with the offline sample instead of downloading from mygbu.in
# TIMETABLE_URL=sample_data/timetable_sample.json

# Optional: change when messages are sent
# MORNING_SUMMARY_AT=07:30
# REMIND_MINUTES_BEFORE=10
